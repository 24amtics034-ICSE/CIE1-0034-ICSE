@model LibraryMember
@{
    ViewData["Title"] = "Issue a Book";
    var books = ViewBag.Books as List<Book> ?? new List<Book>();
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none">&larr; Back to issue register</a>
            <h1 class="h2 mt-3">Issue a Book</h1>
            <p class="text-muted">Enter the student's details and choose an available book.</p>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Library" asp-action="IssueBook" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="MemberName" class="form-label">Member Name</label>
                        <input asp-for="MemberName" class="form-control" placeholder="Enter student's full name" />
                        <span asp-validation-for="MemberName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" placeholder="e.g. Computer Engineering" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" placeholder="student@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BookId" class="form-label">Book</label>
                        <select asp-for="BookId" class="form-select">
                            <option value="">-- Select a book --</option>
                            @foreach (var book in books)
                            {
                                <option value="@book.BookId">#@book.BookId — @book.Title (@book.AvailableCopies available)</option>
                            }
                        </select>
                        <span asp-validation-for="BookId" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="IssueDate" class="form-label"></label>
                            <input asp-for="IssueDate" type="date" class="form-control" />
                            <span asp-validation-for="IssueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReturnDate" class="form-label">Expected / actual return date (optional)</label>
                            <input asp-for="ReturnDate" type="date" class="form-control" />
                            <span asp-validation-for="ReturnDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="alert alert-info small">The standard due date is 14 days after the issue date. Leave Return Date empty until the book is returned.</div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Issue Book</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
